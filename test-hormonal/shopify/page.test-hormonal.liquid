    .r-item summary::after { font-size: 1rem; }
    .incl { flex: none; font-size: .8rem; font-weight: 600; color: var(--accent); padding: 8px 12px; }
    .toggle { flex: none; position: relative; overflow: hidden; padding: 9px 12px; white-space: nowrap; border-radius: 99px; border: 1.5px solid var(--accent); background: var(--white); color: var(--accent); font: 600 .85rem "Inter", sans-serif; cursor: pointer; transition: all .25s; }
    .toggle .t-on { display: none; }
    .toggle[aria-pressed="true"] { background: var(--grad); border-color: transparent; color: var(--white); }
    .toggle[aria-pressed="true"] .t-on { display: inline; }
    .toggle[aria-pressed="true"] .t-add { display: none; }
    .toggle:active { transform: scale(.95); }
    .summary { margin-top: 1rem; padding-top: 1rem; border-top: 1px dashed var(--line); }
    .sum-row { display: flex; justify-content: space-between; font-size: .92rem; color: var(--text); padding: 3px 0; }
    .sum-row.disc { color: var(--accent); font-weight: 600; }
    .sum-row.total { font-size: 1.15rem; font-weight: 700; color: var(--ink); padding-top: 8px; }
    .bump { display: inline-block; animation: bump .45s cubic-bezier(.2, 1.6, .4, 1); }
    @keyframes bump { 0% { transform: scale(1); } 40% { transform: scale(1.18); color: var(--accent); } 100% { transform: scale(1); } }
    .nudge { font-size: .88rem; color: var(--ink); background: var(--blue-soft); border-radius: 12px; padding: 10px 12px; margin: .8rem 0; }
    .summary .btn { width: 100%; }
    .email-step h3 { font-size: clamp(1.4rem, 3.2vw, 1.8rem); margin-bottom: .4rem; }
    .email-step .hint { margin-bottom: 1.2rem; }
    #lead-form { display: grid; gap: 14px; }
    .field span { display: block; font-size: .85rem; font-weight: 600; color: var(--ink); margin-bottom: 6px; }
    .field input { width: 100%; padding: 15px 16px; border-radius: 14px; border: 1.5px solid var(--line); font: 400 1rem "Inter", sans-serif; color: var(--text); background: var(--white); transition: border-color .2s, box-shadow .2s; }
    .field input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 4px var(--accent-soft); }
    .check { display: flex; gap: 10px; align-items: flex-start; font-size: .88rem; color: var(--text); cursor: pointer; }
    .check input { flex: none; width: 20px; height: 20px; margin-top: 1px; accent-color: var(--accent); }
    .check a { color: var(--ink-soft); text-decoration: underline; }
    .form-error { color: #c0392b; font-size: .88rem; min-height: 1em; margin: -4px 0 -6px; }
    .form-note { font-size: .8rem; text-align: center; }
    #lead-form .btn { width: 100%; margin-top: 4px; }

