{% layout none %}
<!doctype html>
<html lang="es">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Test hormonal gratis | Descubre cómo están tus hormonas</title>
  <meta name="description" content="Haz el test hormonal gratuito en 2 minutos y descubre qué te está diciendo tu cuerpo: ciclo, energía, piel, ánimo y antojos.">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,400;1,9..144,400&family=Inter:wght@300;400;500;600&display=swap" rel="stylesheet">
  <style>
    :root {
      --ink: #0e3a4f;
      --ink-soft: #2b7a9a;
      --text: #1f3340;
      --muted: #5f7480;
      --bg: #ffffff;
      --bg-alt: #f2f9fb;
      --white: #ffffff;
      --line: #dceaf0;
      --accent: #14a38b;
      --accent-soft: #dcf4ee;
      --blue: #2f80c8;
      --blue-soft: #e3f0fb;
      --sage: #4fbf8f;
      --grad: linear-gradient(120deg, #2f80c8 0%, #14a38b 100%);
      --radius: 24px;
      --max: 1080px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { scroll-behavior: smooth; }
    body {
      font-family: "Inter", system-ui, sans-serif; color: var(--text); background: var(--bg);
      line-height: 1.65; overflow-x: hidden; -webkit-font-smoothing: antialiased;
    }
    a { color: inherit; }
    h1, h2, h3 { font-family: "Fraunces", Georgia, serif; font-weight: 400; color: var(--ink); line-height: 1.15; letter-spacing: -.01em; }
    h1 em, h2 em { font-style: italic; color: var(--accent); }
    p { color: var(--muted); }
    .container { width: 100%; max-width: var(--max); margin: 0 auto; padding: 0 20px; }
    section { padding: 88px 0; }
    .eyebrow {
      display: inline-block; font-size: .72rem; font-weight: 600; letter-spacing: .18em; text-transform: uppercase;
      color: var(--ink-soft); margin-bottom: 1rem;
    }
    .center { text-align: center; }

    .btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 10px;
      padding: 17px 34px; border-radius: 999px; border: 0;
      background: var(--ink); color: var(--white); text-decoration: none;
      font: 600 1rem "Inter", sans-serif; letter-spacing: .01em; cursor: pointer;
      box-shadow: 0 10px 30px rgba(14, 58, 79, .22); transition: transform .15s, background .2s;
    }
    .btn:hover { background: #164e66; transform: translateY(-1px); }
    .btn-accent { background: var(--accent); box-shadow: 0 10px 30px rgba(20, 163, 139, .35); }
    .btn-accent:hover { background: #0f8a75; }
    .btn-ghost { background: none; box-shadow: none; color: var(--ink-soft); padding: 10px 14px; font-weight: 500; }
    .btn-ghost:hover { background: none; color: var(--ink); transform: none; }

    /* ---------- Barra superior ---------- */
    .topbar { background: var(--grad); color: #d9eef5; text-align: center; font-size: .82rem; padding: 9px 16px; }
    .topbar strong { color: var(--white); }

    /* ---------- Hero ---------- */
    .hero { padding: 64px 0 80px; background: var(--white); position: relative; overflow: hidden; isolation: isolate; }
    .hero-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: 56px; align-items: center; }
    .hero h1 { font-size: clamp(2.3rem, 5.4vw, 3.9rem); margin-bottom: 1.3rem; }
    .hero .lead { font-size: 1.12rem; max-width: 520px; margin-bottom: 2rem; color: var(--text); }
    .hero-meta { display: flex; flex-wrap: wrap; gap: 10px 22px; margin-top: 1.6rem; font-size: .88rem; color: var(--muted); }
    .hero-meta span::before { content: "✓"; color: var(--sage); font-weight: 700; margin-right: 7px; }
    .hero-card {
      background: var(--white); border-radius: var(--radius); padding: 30px; border: 1px solid var(--line);
      box-shadow: 0 30px 60px rgba(14, 58, 79, .08);
    }
    .hero-card h3 { font-size: 1.25rem; margin-bottom: 1rem; }
    .signs { list-style: none; display: grid; gap: 10px; }
    .signs li { display: flex; gap: 12px; align-items: center; padding: 12px 14px; background: var(--bg); border-radius: 14px; font-size: .95rem; color: var(--text); }
    .signs li b { flex: none; width: 30px; height: 30px; border-radius: 50%; display: grid; place-items: center; background: var(--accent-soft); color: var(--ink); font-weight: 600; font-size: .85rem; }
    .hero-card p { margin-top: 1rem; font-size: .9rem; }

    /* ---------- Cómo funciona ---------- */
    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px; }
    .step { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 28px; }
    .step .num { font-family: "Fraunces", serif; font-size: 2.2rem; line-height: 1; margin-bottom: .8rem; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; display: inline-block; }
    .step h3 { font-size: 1.15rem; margin-bottom: .4rem; }
    h2 { font-size: clamp(1.8rem, 3.6vw, 2.5rem); margin-bottom: .8rem; }
    .section-intro { max-width: 600px; margin: 0 auto; }

    /* ---------- Quiz ---------- */
    #test { background: var(--white); position: relative; overflow: hidden; }
    .quiz {
      max-width: 680px; margin: 40px auto 0; background: var(--white); border-radius: var(--radius);
      border: 1px solid var(--line); padding: 36px; box-shadow: 0 30px 60px rgba(14, 58, 79, .07);
      scroll-margin-top: 16px;
    }
    .progress { height: 6px; background: var(--bg-alt); border-radius: 99px; overflow: hidden; margin-bottom: 10px; }
    .progress span { display: block; height: 100%; width: 0; background: linear-gradient(90deg, var(--accent), var(--ink-soft)); transition: width .35s ease; }
    .progress-label { font-size: .8rem; color: var(--muted); margin-bottom: 1.6rem; }
    .question h3 { font-size: clamp(1.3rem, 3vw, 1.6rem); margin-bottom: .4rem; }
    .question .hint { font-size: .9rem; margin-bottom: 1.4rem; }
    .options { display: grid; gap: 10px; }
    .option {
      display: flex; align-items: center; gap: 14px; width: 100%; text-align: left;
      padding: 16px 18px; border-radius: 16px; border: 1.5px solid var(--line); background: var(--white);
      font: 500 1rem "Inter", sans-serif; color: var(--text); cursor: pointer; transition: border-color .15s, background .15s;
    }
    .option::before { content: ""; flex: none; width: 20px; height: 20px; border-radius: 50%; border: 1.5px solid var(--line); transition: all .15s; }
    .option:hover { border-color: var(--accent); background: #f6fcfa; }
    .option.selected { border-color: var(--accent); background: var(--accent-soft); }
    .option.selected::before { border-color: var(--accent); background: var(--accent); box-shadow: inset 0 0 0 4px var(--accent-soft); }
    .quiz-nav { display: flex; justify-content: space-between; align-items: center; margin-top: 1.4rem; min-height: 44px; }
    .fade-in { animation: fade .35s ease; }
    @keyframes fade { from { opacity: 0; transform: translateY(8px); } to { opacity: 1; transform: none; } }

    /* ---------- Cargando y resultado ---------- */
    .loading { text-align: center; padding: 30px 0; }
    .spinner { width: 46px; height: 46px; border-radius: 50%; border: 4px solid var(--accent-soft); border-top-color: var(--accent); margin: 0 auto 1.2rem; animation: spin .9s linear infinite; }
    @keyframes spin { to { transform: rotate(360deg); } }
    .result-tag { display: inline-block; padding: 6px 14px; border-radius: 99px; font-size: .78rem; font-weight: 600; letter-spacing: .06em; text-transform: uppercase; margin-bottom: 1rem; }
    .result-tag.low { background: #dff3ea; color: #137a63; }
    .result-tag.mid { background: #e3f0fb; color: #1f5f99; }
    .result-tag.high { background: var(--accent-soft); color: #0e3a4f; }
    .result h3 { font-size: clamp(1.5rem, 3.4vw, 1.9rem); margin-bottom: .8rem; }
    .result > p { color: var(--text); margin-bottom: 1.2rem; }
    .meter { margin: 1.4rem 0; }
    .meter-bar { height: 10px; border-radius: 99px; background: linear-gradient(90deg, var(--sage), #2f80c8, var(--accent)); position: relative; }
    .meter-dot { position: absolute; top: 50%; width: 22px; height: 22px; border-radius: 50%; background: var(--white); border: 4px solid var(--ink); transform: translate(-50%, -50%); transition: left .8s ease; left: 0; }
    .meter-labels { display: flex; justify-content: space-between; font-size: .75rem; color: var(--muted); margin-top: 8px; }
    .prod { display: flex; align-items: center; gap: 12px; background: var(--white); border-radius: 14px; padding: 8px 12px 8px 8px; margin: 0 0 1rem; color: var(--text); }
    .prod img { width: 56px; height: 56px; object-fit: cover; border-radius: 10px; flex: none; background: var(--bg-alt); }
    .prod strong { display: block; font-size: .92rem; color: var(--ink); line-height: 1.3; }
    .prod span { font-size: .8rem; color: var(--muted); }
    .prod em { display: block; font-style: normal; font-weight: 600; font-size: .85rem; color: var(--ink); white-space: nowrap; }
    .combo-tag { display: inline-block; font-size: .72rem; font-weight: 600; letter-spacing: .08em; text-transform: uppercase; color: var(--accent); margin-bottom: .4rem; }
    .btn-line { background: var(--white); color: var(--ink); border: 1.5px solid var(--ink); box-shadow: none; }
    .btn-line:hover { background: var(--ink); color: var(--white); }
    .legal-note { font-size: .75rem; color: var(--muted); margin-top: 1rem; }
    .reasons-title { font-family: "Fraunces", serif; font-weight: 400; font-size: 1.3rem; color: var(--ink); margin-top: 1.6rem; }
    .reasons-sub { font-size: .9rem; margin-bottom: .8rem; }
    .reasons { list-style: none; display: grid; gap: 10px; margin-bottom: 1.6rem; }
    .reasons li { padding: 16px; background: var(--bg); border-radius: 14px; border-left: 3px solid var(--accent); }
    .reasons li strong { display: block; color: var(--ink); margin-bottom: .3rem; }
    .reasons li p { font-size: .93rem; color: var(--text); }
    .reasons .study { display: inline-block; margin-top: .5rem; font-size: .78rem; color: var(--ink-soft); text-decoration: underline; text-underline-offset: 2px; }
    .reco-tag { display: inline-block; font-size: .7rem; font-weight: 600; letter-spacing: .14em; text-transform: uppercase; color: #8fe0cb; margin-bottom: .5rem; }
    .reco .dose { font-size: .85rem; color: #b9d6e0; border-top: 1px solid rgba(255,255,255,.15); padding-top: .9rem; }
    .reco { background: linear-gradient(145deg, #0e3a4f 0%, #145b6e 60%, #13806f 100%); color: #d9eef5; border-radius: 20px; padding: 26px; }
    .reco h4 { font-family: "Fraunces", serif; font-weight: 400; font-size: 1.35rem; color: var(--white); margin-bottom: .5rem; }
    .reco p { color: #cfe6ee; margin-bottom: 1.3rem; font-size: .95rem; }
    .reco .btn { width: 100%; }
    .restart { margin-top: 1rem; text-align: center; }

    /* ---------- Testimonios ---------- */
    .quotes { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; margin-top: 48px; }
    .quote { background: var(--white); border: 1px solid var(--line); border-radius: var(--radius); padding: 26px; }
    .quote .stars { color: #e0a85a; letter-spacing: 2px; margin-bottom: .6rem; }
    .quote p { color: var(--text); font-size: .96rem; margin-bottom: 1rem; }
    .quote span { font-size: .85rem; color: var(--muted); }

    /* ---------- FAQ ---------- */
    .faq { max-width: 720px; margin: 40px auto 0; }
    details { border-bottom: 1px solid var(--line); padding: 18px 0; }
    summary { cursor: pointer; list-style: none; font-weight: 600; color: var(--ink); display: flex; justify-content: space-between; gap: 16px; }
    summary::-webkit-details-marker { display: none; }
    summary::after { content: "+"; font-size: 1.3rem; line-height: 1; color: var(--accent); }
    details[open] summary::after { content: "–"; }
    details p { margin-top: .7rem; }

    /* ---------- CTA final y pie ---------- */
    .final { background: var(--white); text-align: center; }
    .final-box { background: var(--grad); border-radius: 32px; padding: 64px 24px; position: relative; overflow: hidden; }
    .final h2 { color: var(--white); }
    .final h2 em { color: #c9f5e8; }
    .final p { color: #cfe6ee; margin-bottom: 2rem; }
    .final .btn { background: var(--white); color: var(--ink); }
    .final p { color: #e6f4f8; }
    footer { padding: 32px 0 110px; font-size: .78rem; text-align: center; }
    footer p { max-width: 720px; margin: 0 auto .6rem; }

    /* Botón fijo en móvil */
    .sticky-cta {
      position: fixed; left: 12px; right: 12px; bottom: 12px; z-index: 40; display: none;
      transition: transform .3s, opacity .3s;
    }
    .sticky-cta .btn { width: 100%; }
    .sticky-cta.hidden { transform: translateY(140%); opacity: 0; pointer-events: none; }

    @media (max-width: 860px) {
      section { padding: 64px 0; }
      .hero { padding: 40px 0 56px; }
      .hero-grid, .steps, .quotes { grid-template-columns: 1fr; }
      .hero-grid { gap: 36px; }
      .hero .btn { width: 100%; }
      .quiz { padding: 24px 18px; }
      .sticky-cta { display: block; }
      .routine { padding: 16px 12px; }
      .tier strong { font-size: 1.2rem; }
    }

    /* ---------- Movimiento e interacción ---------- */
    .blob { position: absolute; border-radius: 50%; filter: blur(60px); opacity: .55; z-index: -1; pointer-events: none; animation: float 14s ease-in-out infinite alternate; }
    .b1 { width: 420px; height: 420px; background: #bfe0f7; top: -120px; right: -80px; }
    .b2 { width: 320px; height: 320px; background: #c4eedf; bottom: -120px; left: -100px; animation-duration: 18s; }
    .b3 { width: 220px; height: 220px; background: #d6f0f6; top: 40%; left: 45%; animation-duration: 11s; }
    .b4 { width: 380px; height: 380px; background: #d2ecf9; top: 10%; left: -160px; animation-duration: 16s; }
    .b5 { width: 340px; height: 340px; background: #cdf1e4; bottom: 0; right: -140px; animation-duration: 20s; }
    #test > .container { position: relative; z-index: 1; }
    @keyframes float {
      0% { transform: translate(0, 0) scale(1); }
      50% { transform: translate(40px, 30px) scale(1.08); }
      100% { transform: translate(-30px, 50px) scale(.95); }
    }

    .rotator { display: inline-grid; vertical-align: bottom; }
    .rotator .word { grid-area: 1 / 1; opacity: 0; transform: translateY(.5em); transition: opacity .5s, transform .5s; white-space: nowrap;
      background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; padding-right: .08em; }
    .rotator .word.is-on { opacity: 1; transform: none; }
    .rotator .word.is-out { opacity: 0; transform: translateY(-.5em); }
    h2 em { background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }

    .reveal { opacity: 0; transform: translateY(28px); transition: opacity .7s ease, transform .7s cubic-bezier(.2, .7, .2, 1); }
    .reveal.in { opacity: 1; transform: none; }

    .btn { position: relative; overflow: hidden; }
    .btn-accent { background: var(--grad); }
    .btn-accent:hover { background: var(--grad); filter: brightness(1.08); }
    .pulse { animation: pulse 2.4s ease-in-out infinite; }
    @keyframes pulse {
      0%, 100% { box-shadow: 0 10px 30px rgba(20, 163, 139, .30), 0 0 0 0 rgba(20, 163, 139, .35); }
      50% { box-shadow: 0 10px 30px rgba(20, 163, 139, .30), 0 0 0 12px rgba(20, 163, 139, 0); }
    }
    .ripple { position: absolute; border-radius: 50%; transform: scale(0); background: rgba(255, 255, 255, .45); animation: ripple .6s ease-out; pointer-events: none; }
    .option .ripple { background: rgba(20, 163, 139, .25); }
    @keyframes ripple { to { transform: scale(4); opacity: 0; } }

    .hero-card { transition: transform .4s ease, box-shadow .4s ease; }
    .signs-hint { margin: -.6rem 0 .8rem; font-size: .85rem; }
    .signs li { padding: 0; background: none; }
    .sign { width: 100%; display: flex; gap: 12px; align-items: center; padding: 12px 14px; border-radius: 14px; border: 1.5px solid transparent;
      background: var(--bg-alt); font: 400 .95rem "Inter", sans-serif; color: var(--text); text-align: left; cursor: pointer; transition: all .25s; }
    .sign b { flex: none; width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; border: 1.5px solid var(--line); background: var(--white); color: transparent; font-size: .8rem; transition: all .25s; }
    .sign:hover { transform: translateX(4px); border-color: var(--line); }
    .sign.on { background: var(--accent-soft); border-color: var(--accent); }
    .sign.on b { background: var(--accent); border-color: var(--accent); color: var(--white); transform: scale(1.1); }
    .signs-meter { height: 6px; background: var(--bg-alt); border-radius: 99px; overflow: hidden; margin-top: 1rem; }
    .signs-meter span { display: block; height: 100%; width: 0; background: var(--grad); transition: width .5s cubic-bezier(.2, .7, .2, 1); }
    #signs-msg { transition: color .3s; }
    #signs-msg.hot { color: var(--ink); font-weight: 600; }
    .signs-cta { width: 100%; margin-top: 1rem; display: none; }
    .signs-cta.show { display: inline-flex; animation: pop .45s cubic-bezier(.2, 1.4, .4, 1); }
    @keyframes pop { from { opacity: 0; transform: scale(.85); } to { opacity: 1; transform: none; } }

    .step, .quote { transition: transform .35s ease, box-shadow .35s ease, border-color .35s; }
    .step:hover, .quote:hover { transform: translateY(-6px); box-shadow: 0 20px 40px rgba(14, 58, 79, .08); border-color: #b9dbe8; }
    .step .ico { float: right; font-size: 1.6rem; transition: transform .4s; }
    .step:hover .ico { transform: rotate(-12deg) scale(1.2); }

    .progress span { background: var(--grad); position: relative; }
    .progress span::after { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, rgba(255,255,255,.6), transparent); animation: shimmer 1.6s infinite; }
    @keyframes shimmer { from { transform: translateX(-100%); } to { transform: translateX(100%); } }
    .option { position: relative; overflow: hidden; opacity: 0; animation: optIn .45s ease forwards; transition: border-color .15s, background .15s, transform .15s; }
    .option:hover { transform: translateX(4px); background: var(--bg-alt); }
    .option:active { transform: scale(.98); }
    .option.selected::before { box-shadow: inset 0 0 0 4px var(--accent-soft); }
    @keyframes optIn { from { opacity: 0; transform: translateY(12px); } to { opacity: 1; transform: none; } }
    .question.fade-in { animation: slideIn .4s ease; }
    @keyframes slideIn { from { opacity: 0; transform: translateX(30px); } to { opacity: 1; transform: none; } }
    .q-emoji { font-size: 2rem; display: inline-block; margin-bottom: .4rem; animation: bob 2.4s ease-in-out infinite; }
    @keyframes bob { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }

    .stagger > *, .pop-in { opacity: 0; animation: optIn .55s ease forwards; }
    .score-num { font-family: "Fraunces", serif; font-size: 2.6rem; line-height: 1; background: var(--grad); -webkit-background-clip: text; background-clip: text; color: transparent; }
    .score-row { display: flex; align-items: baseline; gap: 10px; margin: .4rem 0 .2rem; }
    .score-row span:last-child { font-size: .85rem; color: var(--muted); }
    .confetti { position: fixed; top: -12px; width: 9px; height: 14px; border-radius: 2px; z-index: 100; pointer-events: none; animation: fall linear forwards; }
    @keyframes fall { to { transform: translateY(105vh) rotate(720deg); opacity: .8; } }
    .faq-section { background: var(--white); }
    details { transition: background .2s; }
    details[open] { background: linear-gradient(90deg, var(--bg-alt), transparent); border-radius: 12px; padding-left: 12px; }
    summary::after { transition: transform .3s; }
    details[open] summary::after { transform: rotate(180deg); }

    .price-line { margin: -.4rem 0 1rem; color: #cfe6ee; }
    .price-line s { opacity: .7; }
    .price-line strong { font-size: 1.3rem; color: var(--white); margin: 0 6px; }
    .badge { display: inline-block; font-size: .72rem; font-weight: 600; padding: 4px 10px; border-radius: 99px; background: rgba(255,255,255,.16); color: #c9f5e8; }
    .reco-more { display: block; text-align: center; margin-top: .9rem; font-size: .88rem; color: #c9f5e8; text-decoration: underline; text-underline-offset: 3px; }
    .routine { margin-top: 1.8rem; padding: 22px; border-radius: 22px; border: 1.5px solid var(--line); background: linear-gradient(180deg, #f3fafc, #ffffff 30%); scroll-margin-top: 16px; }
    .routine .reasons-title { margin-top: .2rem; }
    .tiers { position: relative; display: grid; grid-template-columns: repeat(3, 1fr); gap: 6px; margin: 1rem 0 1.2rem; padding-top: 14px; }
    .tiers-bar { position: absolute; top: 0; left: 16%; right: 16%; height: 6px; border-radius: 99px; background: var(--line); overflow: hidden; }
    .tiers-bar span { display: block; height: 100%; width: 0; background: var(--grad); transition: width .5s cubic-bezier(.2, .7, .2, 1); }
    .tier { text-align: center; padding: 10px 4px; border-radius: 14px; border: 1.5px solid var(--line); background: var(--white); transition: all .3s; }
    .tier strong { display: block; font-family: "Fraunces", serif; font-weight: 400; font-size: 1.4rem; color: var(--muted); line-height: 1.1; transition: color .3s; }
    .tier span { font-size: .72rem; color: var(--muted); }
    .tier.done strong { color: var(--ink-soft); }
    .tier.active { border-color: var(--accent); background: var(--accent-soft); transform: translateY(-3px); box-shadow: 0 10px 22px rgba(20, 163, 139, .18); }
    .tier.active strong { color: var(--accent); }
    .r-item { border: 1.5px solid var(--line); border-radius: 16px; padding: 12px; margin-bottom: 10px; background: var(--white); transition: border-color .25s, background .25s, transform .25s; }
    .r-item.on, .r-item.fixed { border-color: var(--accent); background: #f2fbf8; }
    .r-item.reco-item:not(.on) { border-style: dashed; border-color: #9fd9c9; }
    .r-row { display: flex; align-items: center; gap: 10px; }
