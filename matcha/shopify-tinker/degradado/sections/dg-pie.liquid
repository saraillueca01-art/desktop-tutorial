{% render 'dg-recursos' %}
{%- assign form_id = 'dg-news-' | append: section.id -%}
<footer class="dg dg-pie">
  {%- if section.settings.newsletter -%}
    <div class="dg-news">
      <div class="dg-wrap">
        <div class="dg-suscribe">
          <div>
            {%- if section.settings.news_ey != blank -%}<p class="dg-eyebrow">{{ section.settings.news_ey }}</p>{%- endif -%}
            <h2>{{ section.settings.news_titulo }} <em>{{ section.settings.news_cursiva }}</em></h2>
            {%- if section.settings.news_texto != blank -%}<p class="dg-suscribe__txt">{{ section.settings.news_texto }}</p>{%- endif -%}
          </div>
          {%- form 'customer', id: form_id -%}
            {%- if form.posted_successfully? -%}
              <p role="status">{{ section.settings.news_gracias }}</p>
            {%- else -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="dg-form">
                <label for="{{ form_id }}-email" class="dg-vh">Tu email</label>
                <input id="{{ form_id }}-email" type="email" name="contact[email]" placeholder="tu@email.com" autocomplete="email" required>
                <button type="submit" class="dg-btn dg-btn--verde">{{ section.settings.news_boton }}</button>
              </div>
              {%- if form.errors -%}<p class="dg-legal" role="alert">Revisa el email e inténtalo otra vez.</p>{%- endif -%}
              {%- if section.settings.news_legal != blank -%}<p class="dg-legal">{{ section.settings.news_legal }}</p>{%- endif -%}
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>
  {%- endif -%}
  <div class="dg-pie__caja">
    <div class="dg-wrap">
      <div class="dg-pie__logo">M{%- render 'dg-oo', class: 'dg-oo' -%}DMATCHA</div>
      {%- if section.settings.texto != blank -%}<p>{{ section.settings.texto }}</p>{%- endif -%}
      {%- if section.settings.firma != blank -%}<p class="dg-eyebrow">{{ section.settings.firma }}</p>{%- endif -%}
      <div class="dg-pie__pequeno">
        {%- if section.settings.garantias != blank -%}{%- assign gs = section.settings.garantias | split: ',' -%}{%- for g in gs -%}<span>{{ g | strip }}</span>{%- endfor -%}{%- endif -%}
        {%- if section.settings.instagram != blank -%}<a href="{{ section.settings.instagram }}" target="_blank" rel="noopener">Instagram</a>{%- endif -%}
        {%- if section.settings.tiktok != blank -%}<a href="{{ section.settings.tiktok }}" target="_blank" rel="noopener">TikTok</a>{%- endif -%}
        {%- for link in section.settings.menu.links -%}<a href="{{ link.url }}">{{ link.title }}</a>{%- endfor -%}
        <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "DG · Pie y newsletter",
  "tag": "div",
  "class": "dg-section",
  "settings": [
    { "type": "checkbox", "id": "newsletter", "label": "Mostrar la newsletter", "default": true },
    { "type": "text", "id": "news_ey", "label": "Antetítulo", "default": "Newsletter" },
    { "type": "text", "id": "news_titulo", "label": "Titular", "default": "Entérate" },
    { "type": "text", "id": "news_cursiva", "label": "Titular en cursiva", "default": "de todo" },
    { "type": "text", "id": "news_texto", "label": "Texto", "default": "Novedades, recetas y el día del lanzamiento, antes que nadie." },
    { "type": "text", "id": "news_boton", "label": "Botón", "default": "Apuntarme" },
    { "type": "text", "id": "news_legal", "label": "Texto pequeño", "default": "Al apuntarte aceptas recibir emails de Mood Matcha. Puedes darte de baja cuando quieras." },
    { "type": "text", "id": "news_gracias", "label": "Mensaje al apuntarse", "default": "¡Ya estás dentro! Te escribiremos pronto." },
    { "type": "text", "id": "texto", "label": "Frase bajo el logo", "default": "Matcha Uji de primera cosecha y grado ceremonial. Una marca española." },
    { "type": "text", "id": "firma", "label": "Firma", "default": "BY BENISSALUD" },
    { "type": "text", "id": "garantias", "label": "Datos pequeños", "info": "Separados por comas.", "default": "Envío en 24–72 h, Pago seguro, 14 días para devolverlo" },
    { "type": "url", "id": "instagram", "label": "Instagram", "default": "https://www.instagram.com/bymoodmatcha/" },
    { "type": "url", "id": "tiktok", "label": "TikTok", "default": "https://www.tiktok.com/@bymoodmatcha" },
    { "type": "link_list", "id": "menu", "label": "Menú de enlaces (opcional)" }
  ],
  "presets": [{ "name": "DG · Pie y newsletter", "category": "Mood Matcha Degradado" }]
}
{% endschema %}
