    "mm_moods": {
      "type": "mm-moods",
      "settings": {
        "titulo": "¿Cómo te sientes hoy?"
      },
      "blocks": {
        "mood_1": {
          "type": "mood",
          "settings": {
            "mood": "Focus",
            "receta": "Solo con agua",
            "texto": "2 g de matcha y 70 ml de agua a 80 °C. Bate en zigzag quince segundos y bébelo tranquilo."
          }
        },
        "mood_2": {
          "type": "mood",
          "settings": {
            "mood": "Calma",
            "receta": "Latte templado de avena",
            "texto": "Bate 2 g con un poco de agua y añade 200 ml de bebida de avena espumada."
          }
        },
        "mood_3": {
          "type": "mood",
          "settings": {
            "mood": "Energía",
            "receta": "Con hielo y tónica",
            "texto": "Hielo, 150 ml de tónica y el matcha batido en agua fría por encima."
          }
        },
        "mood_4": {
          "type": "mood",
          "settings": {
            "mood": "Social",
            "receta": "Matcha lemonade",
            "texto": "Limón, agua con gas y matcha. Para compartir en la terraza."
          }
        },
        "mood_5": {
          "type": "mood",
          "settings": {
            "mood": "Antojo",
            "receta": "Matcha affogato",
            "texto": "Una bola de helado de vainilla y el matcha recién batido por encima."
          }
        }
      },
      "block_order": [
        "mood_1",
        "mood_2",
        "mood_3",
        "mood_4",
        "mood_5"
      ]
    },
    "mm_preparacion": {
      "type": "mm-preparacion",
      "settings": {
        "titulo": "Cómo se prepara",
        "texto": "<p>Un minuto y cuatro gestos. Así sale cremoso, sin grumos y sin amargor.</p>",
        "utensilios": "Necesitas un cuenco, un colador fino y un chasen (o un espumador de leche)."
      },
      "blocks": {
        "paso_1": {
          "type": "paso",
          "settings": {
            "dato": "2 g",
            "titulo": "Tamiza",
            "texto": "Tamiza dos cucharaditas de bambú (unos 2 g) en el cuenco para que no queden grumos."
          }
        },
        "paso_2": {
          "type": "paso",
          "settings": {
            "dato": "70 ml a 80 °C",
            "titulo": "Añade el agua",
            "texto": "Agua caliente, nunca hirviendo. Si sale del hervidor, déjala reposar un par de minutos."
          }
        },
        "paso_3": {
          "type": "paso",
          "settings": {
            "dato": "15 s",
            "titulo": "Bate en zigzag",
            "texto": "Con el chasen, mueve la muñeca dibujando una M, sin tocar el fondo, hasta que salga una espuma fina."
          }
        },
        "paso_4": {
          "type": "paso",
          "settings": {
            "dato": "Tu mood",
            "titulo": "Disfrútalo",
            "texto": "Bébelo así, o añade leche espumada, hielo o tónica. Cada mood tiene su receta."
          }
        }
      },
      "block_order": [
        "paso_1",
        "paso_2",
        "paso_3",
        "paso_4"
      ]
    },
