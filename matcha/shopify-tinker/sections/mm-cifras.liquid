{% render 'mm-recursos' %}
{%- comment -%} Sellos redondos con el texto girando alrededor. {%- endcomment -%}
{%- assign estilos = 'deep,line,accent,line' | split: ',' -%}
<section class="mm mm-sellos">
  <div class="mm-sellos__head">
    {%- if section.settings.texto != blank -%}<p class="mm-eyebrow">{{ section.settings.titulo }}</p><h2>{{ section.settings.texto }}</h2>{%- else -%}<h2>{{ section.settings.titulo }}</h2>{%- endif -%}
  </div>
  <div class="mm-sellos__row">
    {%- for block in section.blocks -%}
      {%- liquid
        assign e = forloop.index0 | modulo: estilos.size
        assign centro = block.settings.centro | default: block.settings.cifra
        assign aro = block.settings.aro
        if aro == blank
          assign aro = block.settings.texto | default: block.settings.cifra
        endif
        assign aro = aro | upcase | append: ' · '
        assign giro = forloop.index | times: 37 | modulo: 13 | minus: 6
      -%}
      <div class="mm-sello mm-sello--{{ estilos[e] }}" style="--r: {{ giro }}deg;" {{ block.shopify_attributes }}>
        <svg viewBox="0 0 100 100" aria-hidden="true"><defs><path id="mm-aro-{{ block.id }}" d="M50,50 m-41,0 a41,41 0 1,1 82,0 a41,41 0 1,1 -82,0"/></defs><text><textPath href="#mm-aro-{{ block.id }}" textLength="252">{{ aro | truncate: 70, '' }}</textPath></text></svg>
        <b>{{ centro }}{%- if block.settings.pie != blank -%}<small>{{ block.settings.pie }}</small>{%- endif -%}</b>
        <span class="visually-hidden">{{ block.settings.cifra }}. {{ block.settings.texto }}</span>
      </div>
    {%- endfor -%}
  </div>
</section>

{% schema %}
{
  "name": "MM · Sellos",
  "tag": "div",
  "class": "mm-section",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Titular", "default": "Cifras clave" },
    { "type": "text", "id": "texto", "label": "Texto", "default": "Lo que hay detrás de cada taza." }
  ],
  "blocks": [
    {
      "type": "cifra",
      "name": "Cifra",
      "settings": [
        { "type": "text", "id": "cifra", "label": "Cifra", "default": "21 días" },
        { "type": "text", "id": "texto", "label": "Texto", "default": "a la sombra antes de la cosecha" },
        { "type": "header", "content": "Sello" },
        { "type": "text", "id": "centro", "label": "Centro del sello", "info": "Algo corto, como «20 días». Vacío: la cifra." },
        { "type": "text", "id": "pie", "label": "Debajo del centro", "info": "Opcional, en letra pequeña." },
        { "type": "text", "id": "aro", "label": "Texto que gira", "info": "Vacío: el texto de la cifra." },
        { "type": "image_picker", "id": "imagen", "label": "Imagen", "info": "No se usa en el diseño de sellos." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM · Cifras clave",
      "category": "Mood Matcha",
      "blocks": [
        { "type": "cifra", "settings": { "cifra": "21 días", "texto": "a la sombra antes de la cosecha" } },
        { "type": "cifra", "settings": { "cifra": "2 g", "texto": "por taza, una cucharadita" } },
        { "type": "cifra", "settings": { "cifra": "15 tazas", "texto": "en cada lata de 30 g" } },
        { "type": "cifra", "settings": { "cifra": "80 °C", "texto": "nunca hirviendo" } },
        { "type": "cifra", "settings": { "cifra": "24–72 h", "texto": "de nuestra casa a la tuya" } }
      ]
    }
  ]
}
{% endschema %}
