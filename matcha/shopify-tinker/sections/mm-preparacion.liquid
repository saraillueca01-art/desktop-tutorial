{% render 'mm-recursos' %}
<section class="mm mm-prep" id="mm-preparacion">
  <div class="mm-prep__head">
    <h2>{{ section.settings.titulo }}</h2>
    {%- if section.settings.texto != blank -%}<div class="mm-prep__intro">{{ section.settings.texto }}</div>{%- endif -%}
    {%- if section.settings.utensilios != blank -%}<p class="mm-prep__tools">{{ section.settings.utensilios }}</p>{%- endif -%}
  </div>

  <ol class="mm-prep__row" data-mm-steps>
    {%- for block in section.blocks -%}
      <li class="mm-prep__card" style="--i: {{ forloop.index0 }}" {{ block.shopify_attributes }}>
        <figure class="mm-prep__pic">
          {%- if block.settings.video != blank or block.settings.imagen != blank -%}
            {% render 'mm-media', video: block.settings.video, image: block.settings.imagen, sizes: '(min-width: 900px) 25vw, 78vw' %}
          {%- else -%}
            <canvas data-mm-bowl data-step="{{ forloop.index0 }}" aria-hidden="true"></canvas>
          {%- endif -%}
          {%- if block.settings.dato != blank -%}<figcaption class="mm-prep__dato">{{ block.settings.dato }}</figcaption>{%- endif -%}
        </figure>
        <div class="mm-prep__txt">
          <span class="mm-prep__num" aria-hidden="true">{{ forloop.index }}</span>
          <h3>{{ block.settings.titulo }}</h3>
          <p>{{ block.settings.texto }}</p>
        </div>
      </li>
    {%- endfor -%}
  </ol>
</section>

{% schema %}
{
  "name": "MM · Cómo se prepara",
  "tag": "div",
  "class": "mm-section",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Titular", "default": "Cómo se prepara" },
    { "type": "richtext", "id": "texto", "label": "Texto", "default": "<p>Un minuto y cuatro gestos.</p>" },
    { "type": "text", "id": "utensilios", "label": "Lo que necesitas", "default": "Cuenco, colador fino y chasen (o espumador de leche)." }
  ],
  "blocks": [
    {
      "type": "paso",
      "name": "Paso",
      "limit": 6,
      "settings": [
        { "type": "image_picker", "id": "imagen", "label": "Foto", "info": "Mejor vertical (4:5). Sin foto se ve un cuenco animado de este paso." },
        { "type": "video", "id": "video", "label": "Vídeo corto", "info": "Opcional. Se muestra en lugar de la foto, sin sonido y en bucle." },
        { "type": "text", "id": "dato", "label": "Dato destacado", "info": "Por ejemplo: 2 g, 80 °C, 15 s.", "default": "2 g" },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Tamiza" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "Dos cucharaditas en el cuenco, sin grumos." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM · Cómo se prepara",
      "category": "Mood Matcha",
      "blocks": [
        { "type": "paso", "settings": { "dato": "2 g", "titulo": "Tamiza", "texto": "Dos cucharaditas en el cuenco, sin grumos." } },
        { "type": "paso", "settings": { "dato": "80 °C", "titulo": "Añade el agua", "texto": "70 ml caliente, nunca hirviendo." } },
        { "type": "paso", "settings": { "dato": "15 s", "titulo": "Bate en zigzag", "texto": "Dibuja una M con el chasen hasta que haga espuma." } },
        { "type": "paso", "settings": { "dato": "Tu mood", "titulo": "Disfrútalo", "texto": "Solo, con leche, con hielo o con tónica." } }
      ]
    }
  ]
}
{% endschema %}
