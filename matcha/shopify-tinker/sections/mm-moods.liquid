{% render 'mm-recursos' %}
{%- comment -%} Recuadro «Hoy estoy en modo…»: al elegir un mood cambia de color solo el recuadro y enseña su receta. {%- endcomment -%}
{%- assign colores = 'focus:#5f8f12,calma:#3f8f86,energia:#b8860b,social:#7a62b0,antojo:#c45577' | split: ',' -%}
{%- assign primero = section.blocks.first -%}
<section class="mm mm-moodbox-wrap">
  {%- if primero -%}
  {%- liquid
    assign c0 = primero.settings.color
    if c0 == blank
      assign k0 = primero.settings.mood | handleize
      for par in colores
        assign kv = par | split: ':'
        if kv[0] == k0
          assign c0 = kv[1]
        endif
      endfor
    endif
    if c0 == blank
      assign c0 = '#5f8f12'
    endif
  -%}
  <div class="mm-moodbox" style="--a: {{ c0 }};" data-mm-moodbox>
    <span class="mm-moodbox__blob" aria-hidden="true"></span><span class="mm-moodbox__blob" aria-hidden="true"></span>
    <h2 class="mm-moodbox__big">{{ section.settings.titulo }} <span data-mm-mood-word>{{ primero.settings.mood | downcase }}</span></h2>
    <div class="mm-moodbox__chips" role="group" aria-label="{{ section.settings.titulo | escape }}">
      {%- for block in section.blocks -%}
        {%- liquid
          assign c = block.settings.color
          if c == blank
            assign k = block.settings.mood | handleize
            for par in colores
              assign kv = par | split: ':'
              if kv[0] == k
                assign c = kv[1]
              endif
            endfor
          endif
          if c == blank
            assign c = '#5f8f12'
          endif
        -%}
        <button type="button" aria-pressed="{% if forloop.first %}true{% else %}false{% endif %}" data-a="{{ c }}" data-word="{{ block.settings.mood | downcase | escape }}" data-receta="{{ block.settings.receta | escape }}" data-texto="{{ block.settings.texto | escape }}" {{ block.shopify_attributes }}>{{ block.settings.mood }}</button>
      {%- endfor -%}
    </div>
    <p class="mm-moodbox__line" aria-live="polite"><b data-mm-mood-receta>{{ primero.settings.receta }}</b> <span data-mm-mood-texto>{{ primero.settings.texto }}</span></p>
  </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "MM · Hoy estoy en modo",
  "tag": "div",
  "class": "mm-section",
  "settings": [
    { "type": "text", "id": "titulo", "label": "Titular", "info": "Va delante del mood elegido.", "default": "Hoy estoy en modo" }
  ],
  "blocks": [
    {
      "type": "mood",
      "name": "Mood",
      "settings": [
        { "type": "text", "id": "mood", "label": "Mood", "default": "Focus" },
        { "type": "text", "id": "receta", "label": "Receta", "default": "Solo con agua" },
        { "type": "textarea", "id": "texto", "label": "Cómo se hace", "default": "2 g de matcha y 70 ml de agua a 80 °C. Bate en zigzag quince segundos y bébelo tranquilo." },
        { "type": "color", "id": "color", "label": "Color del recuadro", "info": "Vacío: verde para Focus, azul agua para Calma, amarillo para Energía, lila para Social y rosa para Antojo." },
        { "type": "image_picker", "id": "imagen", "label": "Imagen", "info": "No se usa en el diseño del recuadro." },
        { "type": "video", "id": "video", "label": "Vídeo", "info": "No se usa en el diseño del recuadro." }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM · Moods",
      "category": "Mood Matcha",
      "blocks": [
        { "type": "mood", "settings": { "mood": "Focus", "receta": "Solo con agua", "texto": "2 g de matcha y 70 ml de agua a 80 °C. Bate en zigzag quince segundos y bébelo tranquilo." } },
        { "type": "mood", "settings": { "mood": "Calma", "receta": "Latte templado de avena", "texto": "Bate 2 g con un poco de agua y añade 200 ml de bebida de avena espumada." } },
        { "type": "mood", "settings": { "mood": "Energía", "receta": "Con hielo y tónica", "texto": "Hielo, 150 ml de tónica y el matcha batido en agua fría por encima." } },
        { "type": "mood", "settings": { "mood": "Social", "receta": "Matcha lemonade", "texto": "Limón, agua con gas y matcha. Para compartir en la terraza." } },
        { "type": "mood", "settings": { "mood": "Antojo", "receta": "Matcha affogato", "texto": "Una bola de helado de vainilla y el matcha recién batido por encima." } }
      ]
    }
  ]
}
{% endschema %}
