{% render 'mm-recursos' %}
<section class="mm mm-garantia-wrap">
  <div class="mm-garantia">
    <div class="mm-garantia__seal">
      <svg viewBox="0 0 100 100" aria-hidden="true"><defs><path id="mm-g-{{ section.id }}" d="M50,50 m-41,0 a41,41 0 1,1 82,0 a41,41 0 1,1 -82,0"/></defs><text><textPath href="#mm-g-{{ section.id }}" textLength="252">{{ section.settings.aro | upcase }} · </textPath></text></svg>
      <b>{{ section.settings.centro }}<small>{{ section.settings.pie }}</small></b>
    </div>
    <div>
      <h2>{{ section.settings.titulo }}</h2>
      {%- if section.settings.texto != blank -%}<p>{{ section.settings.texto }}</p>{%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MM · Garantía",
  "tag": "div",
  "class": "mm-section",
  "settings": [
    { "type": "text", "id": "centro", "label": "Centro del sello", "default": "14" },
    { "type": "text", "id": "pie", "label": "Debajo del centro", "default": "días" },
    { "type": "text", "id": "aro", "label": "Texto que gira", "default": "Compra tranquila · Envío 24–72 h · Pago seguro" },
    { "type": "text", "id": "titulo", "label": "Titular", "default": "Compra sin miedo" },
    { "type": "text", "id": "texto", "label": "Texto", "default": "Tienes 14 días para devolverlo. Te lo enviamos en 24–72 h y el pago es 100 % seguro. Si tienes cualquier duda, escríbenos y te contestamos el mismo día." }
  ],
  "presets": [{ "name": "MM · Garantía", "category": "Mood Matcha" }]
}
{% endschema %}
