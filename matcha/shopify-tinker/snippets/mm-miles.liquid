{%- comment -%} Número con punto de miles: 1234 → 1.234 {%- endcomment -%}
{%- liquid
  assign miles = n | divided_by: 1000 | floor
  assign resto = n | modulo: 1000
  if miles > 0
    assign r = resto | plus: 1000 | append: '' | slice: 1, 3
    echo miles | append: '.' | append: r
  else
    echo n
  endif
-%}