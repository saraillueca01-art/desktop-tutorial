{%- comment -%}
  Galería de la lata: foto principal en grande y miniaturas debajo.
  Uso: {% render 'mm-galeria', p: producto, desde_producto: true, s: section.settings %}
  desde_producto: true usa las fotos del producto; false usa foto_lata y foto_2…foto_5 de la sección.
{%- endcomment -%}
{%- assign ids = 'foto_lata,foto_2,foto_3,foto_4,foto_5' | split: ',' -%}
<div class="mm-gal" data-mm-gal>
  <div class="mm-gal__main">
    {%- assign k = 0 -%}
    {%- if desde_producto -%}
      {%- for m in p.media -%}
        {%- if m.media_type == 'image' -%}
          {%- liquid
            assign carga = 'lazy'
            if k == 0
              assign carga = 'eager'
            endif
          -%}
          {{ m.preview_image | image_url: width: 1600 | image_tag: class: 'mm-gal__img', loading: carga, sizes: '(min-width: 900px) 45vw, 92vw', widths: '600, 900, 1200, 1600', alt: m.alt | default: p.title, data-i: k }}
          {%- assign k = k | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- else -%}
      {%- for id in ids -%}
        {%- assign img = s[id] -%}
        {%- if img != blank -%}
          {%- liquid
            assign carga = 'lazy'
            if k == 0
              assign carga = 'eager'
            endif
          -%}
          {{ img | image_url: width: 1600 | image_tag: class: 'mm-gal__img', loading: carga, sizes: '(min-width: 900px) 45vw, 92vw', widths: '600, 900, 1200, 1600', alt: img.alt | default: 'Lata de Mood Matcha', data-i: k }}
          {%- assign k = k | plus: 1 -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endif -%}
  </div>

  {%- if k > 1 -%}
    <div class="mm-gal__thumbs" role="group" aria-label="Fotos de la lata">
      {%- assign j = 0 -%}
      {%- if desde_producto -%}
        {%- for m in p.media -%}
          {%- if m.media_type == 'image' -%}
            {%- assign j = j | plus: 1 -%}
            <button type="button" data-i="{{ j | minus: 1 }}" aria-label="Ver foto {{ j }}"{% if j == 1 %} aria-current="true"{% endif %}>
              {{ m.preview_image | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for id in ids -%}
          {%- assign img = s[id] -%}
          {%- if img != blank -%}
            {%- assign j = j | plus: 1 -%}
            <button type="button" data-i="{{ j | minus: 1 }}" aria-label="Ver foto {{ j }}"{% if j == 1 %} aria-current="true"{% endif %}>
              {{ img | image_url: width: 200 | image_tag: loading: 'lazy', alt: '' }}
            </button>
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
    </div>
  {%- endif -%}
</div>
