    { "type": "text", "id": "email_legal", "label": "Texto pequeño", "default": "Solo vale un voto por email. Si no marcas la casilla, usamos tu email únicamente para contar tu voto." },
    { "type": "text", "id": "email_boton", "label": "Botón", "default": "Enviar mi voto" },
    { "type": "text", "id": "email_etiquetas", "label": "Etiquetas en Shopify si acepta novedades", "default": "newsletter, lista-espera, reto-dia-13" },
