{%- comment -%}
  «El botón prohibido» (capítulo 13). Va en la plantilla de contraseña, debajo de «MM · Lote 001», sin tocarla:
  el botón «NO PULSES AQUÍ» se coloca solo bajo la frase tachada. Todo ocurre en una capa a pantalla completa
  en la misma página (sin enlaces ni direcciones nuevas): aviso → juego del impostor → sala secreta → voto → final.
  Los votos se envían a la dirección del «sistema de votos» (Google Apps Script + Google Sheets, ver votos/LEEME.md).
  Sin esa dirección no se guarda ni se simula ningún voto.
{%- endcomment -%}
{%- liquid
  assign sid = section.id | replace: '-', '_'
  assign etiquetas = section.blocks | where: 'type', 'etiqueta'
  assign url_tienda = shop.url
-%}

{%- if request.design_mode -%}
  {%- if section.settings.endpoint == blank -%}
    <div class="mms-aviso-editor" role="note"><b>Votación sin conectar.</b> Pega la dirección del sistema de votos en los ajustes de esta sección («Sistema de votos»). Mientras esté vacía, nadie podrá votar y no se guarda nada.</div>
  {%- endif -%}
  {%- assign sin_imagen = 0 -%}
  {%- for b in etiquetas -%}{%- if b.settings.imagen == blank -%}{%- assign sin_imagen = sin_imagen | plus: 1 -%}{%- endif -%}{%- endfor -%}
  {%- if sin_imagen > 0 or etiquetas.size == 0 -%}
    <div class="mms-aviso-editor" role="note"><b>Faltan imágenes de etiquetas.</b> Sube las propuestas en los bloques «Etiqueta» de esta sección antes de publicar el vídeo.</div>
  {%- endif -%}
{%- endif -%}

<button type="button" class="mms-trigger" id="mms-trigger-{{ sid }}" hidden>
  <i aria-hidden="true"></i>{{ section.settings.boton_texto }}
</button>

<div class="mms" id="mms-{{ sid }}" role="dialog" aria-modal="true" aria-label="Secreto de Mood Matcha" hidden
  data-endpoint="{{ section.settings.endpoint | escape }}" data-url="{{ url_tienda }}" data-compartir="{{ section.settings.compartir_texto | escape }}">
  <div class="mms__fondo" aria-hidden="true"></div>
  <button type="button" class="mms__volver" data-mms-cerrar>← Volver</button>

  <!-- 1 · aviso -->
  <section class="mms__paso" data-paso="aviso">
    <p class="mms__alerta">{{ section.settings.aviso_titulo }}</p>
    <p class="mms__texto">{{ section.settings.aviso_texto }}</p>
    <button type="button" class="mms__btn" data-mms-ir="juego">{{ section.settings.aviso_boton }}</button>
  </section>

  <!-- 2 · juego -->
  <section class="mms__paso" data-paso="juego" hidden>
    <h2 class="mms__titulo">{{ section.settings.juego_titulo }}</h2>
    <p class="mms__texto">{{ section.settings.juego_texto }}</p>
    <div class="mms__objetos" data-mms-objetos></div>
    <p class="mms__msg" data-mms-msg aria-live="polite"></p>
    <div class="mms__exito" data-mms-exito hidden>
      <div class="mms__candado" aria-hidden="true">🔓</div>
      <p class="mms__alerta">{{ section.settings.exito_titulo }}</p>
      <p class="mms__texto">{{ section.settings.exito_texto }}</p>
      <button type="button" class="mms__btn" data-mms-ir="sala">Entrar</button>
    </div>
  </section>

  <!-- 3 · sala secreta y voto -->
  <section class="mms__paso mms__paso--sala" data-paso="sala" hidden>
    <h2 class="mms__titulo">{{ section.settings.sala_titulo }}</h2>
    <p class="mms__texto">{{ section.settings.sala_texto_1 }}</p>
    <p class="mms__texto">{{ section.settings.sala_texto_2 }}</p>
    <div class="mms__etiquetas" data-mms-etiquetas></div>
    <p class="mms__votar">{{ section.settings.votar_titulo }}</p>
    <button type="button" class="mms__btn" data-mms-votar disabled>Confirmar mi voto</button>
    <p class="mms__msg" data-mms-estado aria-live="polite"></p>
  </section>

  <!-- 3b · email para que el voto cuente -->
  <section class="mms__paso" data-paso="email" hidden>
    <p class="mms__votar">{{ section.settings.email_antetitulo }}</p>
    <h2 class="mms__titulo">{{ section.settings.email_titulo }}</h2>
    <div class="mms__elegida" data-mms-elegida></div>
    <form class="mms__form" data-mms-form novalidate>
      <label for="mms-email-{{ sid }}" class="mms__vh">Tu email</label>
      <input id="mms-email-{{ sid }}" type="email" name="email" placeholder="tu@email.com" autocomplete="email" inputmode="email" required>
      <label class="mms__check"><input type="checkbox" name="novedades"> <span>{{ section.settings.email_novedades }}</span></label>
      <p class="mms__legal">{{ section.settings.email_legal }}</p>
      <p class="mms__msg" data-mms-error aria-live="polite"></p>
      <button type="submit" class="mms__btn">{{ section.settings.email_boton }}</button>
    </form>
    <button type="button" class="mms__enlace" data-mms-ir="sala">← Cambiar de etiqueta</button>
  </section>

  <!-- 4 · final -->
  <section class="mms__paso" data-paso="final" hidden>
    <p class="mms__alerta mms__alerta--grande">{{ section.settings.final_titulo }}</p>
    <p class="mms__texto">{{ section.settings.final_texto }}</p>
    <p class="mms__comenta">{{ section.settings.final_comentario }}</p>
    <button type="button" class="mms__btn" data-mms-compartir>{{ section.settings.compartir_boton }}</button>
    <p class="mms__msg" data-mms-compartido aria-live="polite"></p>
    <button type="button" class="mms__enlace" data-mms-cerrar>Volver a la página de inicio</button>
  </section>

  <!-- ampliar etiqueta -->
  <div class="mms__lupa" data-mms-lupa hidden>
    <button type="button" class="mms__volver" data-mms-lupa-cerrar>✕ Cerrar</button>
    <div class="mms__lupa-marco"><img alt="" data-mms-lupa-img width="1600" height="1200"></div>
    <p class="mms__pista">Toca la imagen para acercarte</p>
  </div>
  <div class="mms__confeti" aria-hidden="true" data-mms-confeti></div>
</div>

<template id="mms-objetos-{{ sid }}">
  {%- assign tipos = 'chasen,chashaku,chawan,tamiz,electrico,cafetera' | split: ',' -%}
  {%- for t in tipos -%}
    {%- assign clave = 'img_' | append: t -%}
    {%- assign img = section.settings[clave] -%}
    <button type="button" class="mms__obj" data-tipo="{{ t }}" aria-label="Objeto {{ forloop.index }}">
      {%- if img != blank -%}
        {{ img | image_url: width: 360 | image_tag: loading: 'lazy', alt: '', widths: '180, 360' }}
      {%- else -%}
        {% render 'mm-secreto-objeto', tipo: t, uid: sid %}
      {%- endif -%}
    </button>
  {%- endfor -%}
</template>

<template id="mms-etiquetas-{{ sid }}">
  {%- for b in etiquetas -%}
    <div class="mms__eti" data-codigo="{{ b.settings.codigo | default: forloop.index | escape }}" {{ b.shopify_attributes }}>
      <button type="button" class="mms__eti-img" data-mms-ampliar aria-label="Ampliar {{ b.settings.nombre | escape }}">
        {%- if b.settings.imagen != blank -%}
          <img src="{{ b.settings.imagen | image_url: width: 1200 }}" srcset="{{ b.settings.imagen | image_url: width: 600 }} 600w, {{ b.settings.imagen | image_url: width: 1200 }} 1200w" sizes="(min-width: 760px) 320px, 85vw" data-grande="{{ b.settings.imagen | image_url: width: 2400 }}" alt="{{ b.settings.nombre | escape }}" loading="lazy" width="{{ b.settings.imagen.width }}" height="{{ b.settings.imagen.height }}">
        {%- else -%}
          <span class="mms__eti-vacia">Aquí irá la {{ b.settings.nombre | default: 'propuesta' }}</span>
        {%- endif -%}
        <span class="mms__lupa-ico" aria-hidden="true">⤢</span>
      </button>
      <button type="button" class="mms__eti-elegir" aria-pressed="false" data-mms-elegir>
        <span class="mms__eti-nombre">{{ b.settings.nombre }}</span><span class="mms__eti-check">Elegir</span>
      </button>
    </div>
  {%- endfor -%}
</template>

<style>
  .mms-aviso-editor { margin: 12px; padding: 12px 16px; border-radius: 14px; background: #fde8e6; border: 2px solid #c0392b; color: #8e1d12; font: 400 14px/1.4 system-ui, sans-serif; }
  .mms-trigger { --deep: #1e3322; display: inline-flex; align-items: center; gap: 9px; min-height: 40px; padding: 8px 16px; border: 1px dashed color-mix(in srgb, var(--deep) 55%, transparent); border-radius: 999px; background: transparent; color: var(--deep);
    font: 400 0.68rem/1 var(--mm-logo-font, 'Jost', system-ui, sans-serif); letter-spacing: 0.32em; text-transform: uppercase; cursor: pointer; animation: mms-nervioso 7s ease-in-out 4s infinite; -webkit-tap-highlight-color: transparent; }
  .mms-trigger[hidden] { display: none; }
  .mms-trigger i { width: 7px; height: 7px; border-radius: 50%; background: #c0392b; box-shadow: 0 0 0 0 rgb(192 57 43 / 0.5); animation: mms-latido 2.2s ease-out infinite; }
  .mms-trigger:hover, .mms-trigger:focus-visible { border-style: solid; outline: none; }
  .mms-trigger--flotante { position: fixed; left: 50%; bottom: max(16px, env(safe-area-inset-bottom, 0px)); transform: translateX(-50%); z-index: 20; background: #fff; }
  @keyframes mms-latido { 70% { box-shadow: 0 0 0 7px rgb(192 57 43 / 0); } 100% { box-shadow: 0 0 0 0 rgb(192 57 43 / 0); } }
  @keyframes mms-nervioso { 0%, 92%, 100% { transform: none; } 93% { transform: rotate(-2deg) translateX(-1px); } 95% { transform: rotate(2deg) translateX(1px); } 97% { transform: rotate(-1deg); } }

  /* glitch al pulsar */
  html.mms-glitch body { animation: mms-glitch 0.65s steps(2, end); }
  html.mms-glitch body::after { content: ""; position: fixed; inset: 0; z-index: 9998; pointer-events: none; background: repeating-linear-gradient(0deg, rgb(30 51 34 / 0.08) 0 2px, transparent 2px 5px); mix-blend-mode: multiply; animation: mms-scan 0.65s steps(4) forwards; }
  @keyframes mms-glitch { 0% { filter: none; transform: none; } 20% { filter: hue-rotate(80deg) saturate(2); transform: translate(-4px, 1px) skewX(4deg); clip-path: inset(10% 0 30% 0); } 40% { filter: contrast(1.8) saturate(0.2) brightness(1.1); transform: translate(5px, -2px); clip-path: inset(40% 0 5% 0); } 60% { filter: hue-rotate(-60deg); transform: translate(-2px, 2px) skewX(-6deg); clip-path: inset(0 0 55% 0); } 80% { filter: contrast(2); transform: translate(3px, 0); clip-path: none; } 100% { filter: none; transform: none; } }
  @keyframes mms-scan { to { opacity: 0; } }

  .mms { --ink: #1b2a1f; --muted: #5f6b61; --deep: #1e3322; --green: #2f6b2a; --lime: #c9dc5c; --rojo: #c0392b;
    --etiqueta: linear-gradient(100deg, #add9af 0%, #fbf8d1 36%, #f3e5cd 68%, #c9e2af 100%);
    --sans: var(--mm-logo-font, 'Jost', system-ui, sans-serif); --serif: 'Cormorant Garamond', 'Cormorant', Garamond, serif;
    position: fixed; inset: 0; z-index: 9999; overflow-y: auto; overscroll-behavior: contain; color: var(--ink); font: 300 16px/1.55 var(--sans);
    padding: max(58px, calc(env(safe-area-inset-top, 0px) + 54px)) max(18px, env(safe-area-inset-right, 0px)) max(28px, env(safe-area-inset-bottom, 0px)) max(18px, env(safe-area-inset-left, 0px));
    display: grid; place-items: center; animation: mms-entra 0.45s cubic-bezier(.2,.8,.2,1); }
  .mms[hidden], .mms [hidden] { display: none !important; }
  .mms__fondo { position: fixed; inset: 0; z-index: -1; background: radial-gradient(120% 80% at 50% 0%, #ffffff 0%, #f6f8f1 55%, #eef3e6 100%); }
  .mms.is-sala .mms__fondo { background: var(--etiqueta); }
  @keyframes mms-entra { from { opacity: 0; transform: scale(1.03); filter: blur(6px); } }
  .mms *, .mms *::before, .mms *::after { box-sizing: border-box; }
  .mms button { font: inherit; -webkit-tap-highlight-color: transparent; }
  .mms :focus-visible { outline: 2px solid var(--green); outline-offset: 3px; }
  .mms__volver { position: fixed; top: max(12px, calc(env(safe-area-inset-top, 0px) + 8px)); left: max(14px, env(safe-area-inset-left, 0px)); z-index: 3; border: 0; background: rgb(255 255 255 / 0.85); backdrop-filter: blur(8px); border-radius: 999px; padding: 10px 16px; min-height: 40px; color: var(--deep); font-size: 0.9rem; cursor: pointer; box-shadow: 0 2px 10px -4px rgb(0 0 0 / 0.2); }
  .mms__paso { width: min(100%, 560px); display: grid; justify-items: center; text-align: center; gap: 14px; animation: mms-paso 0.45s cubic-bezier(.2,.8,.2,1); }
  .mms__paso--sala { width: min(100%, 980px); }
  @keyframes mms-paso { from { opacity: 0; transform: translateY(14px); } }
  .mms__alerta { margin: 0; font: 500 clamp(1.15rem, 4.6vw, 1.6rem)/1.2 var(--sans); letter-spacing: 0.06em; text-transform: uppercase; color: var(--deep); text-wrap: balance; }
  .mms__alerta--grande { font-size: clamp(1.5rem, 7vw, 2.4rem); }
  .mms__titulo { margin: 0; font: 400 clamp(1.15rem, 4.8vw, 1.7rem)/1.2 var(--sans); letter-spacing: 0.04em; text-transform: uppercase; color: var(--deep); text-wrap: balance; }
  .mms__texto { margin: 0; color: var(--muted); max-width: 46ch; text-wrap: pretty; }
  .mms__comenta { margin: 4px 0 0; font: 400 clamp(1.25rem, 5vw, 1.6rem)/1.3 var(--serif); font-style: italic; color: var(--green); max-width: 30ch; text-wrap: balance; }
  .mms__btn { border: 0; border-radius: 999px; padding: 14px 26px; min-height: 48px; background: var(--deep); color: #fff; font-size: 0.95rem; letter-spacing: 0.12em; text-transform: uppercase; cursor: pointer; transition: transform 0.2s, opacity 0.2s; }
  .mms__btn:active { transform: scale(0.97); }
  .mms__btn[disabled] { opacity: 0.35; cursor: not-allowed; }
  .mms__enlace { border: 0; background: none; color: var(--deep); text-decoration: underline; text-underline-offset: 4px; padding: 10px; cursor: pointer; font-size: 0.9rem; }
  .mms__msg { margin: 0; min-height: 1.6em; font-size: 0.98rem; color: var(--deep); }
  .mms__msg.is-mal { color: var(--rojo); }

  /* juego */
  .mms__objetos { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(10px, 3vw, 18px); width: min(100%, 460px); margin-top: 6px; }
  .mms__obj { aspect-ratio: 1; border: 0; border-radius: 26px; padding: 10%; cursor: pointer; display: grid; place-items: center; min-width: 0;
    background: radial-gradient(circle at 50% 45%, #ffffff 0%, #f7f9f2 55%, #e9f0de 100%); box-shadow: 0 1px 0 rgb(255 255 255 / 0.8) inset, 0 10px 24px -16px rgb(30 51 34 / 0.45), 0 0 0 1px rgb(30 51 34 / 0.06);
    transition: transform 0.25s cubic-bezier(.2,.8,.2,1), box-shadow 0.25s; }
  .mms__obj svg, .mms__obj img { width: 100%; height: 100%; object-fit: contain; display: block; pointer-events: none; }
  .mms__obj:active { transform: scale(0.95); }
  .mms__obj.is-mal { animation: mms-no 0.45s; box-shadow: 0 0 0 2px var(--rojo), 0 10px 24px -16px rgb(30 51 34 / 0.45); }
  .mms__obj.is-bien { animation: mms-si 0.8s cubic-bezier(.2,1.4,.4,1); box-shadow: 0 0 0 3px var(--lime), 0 0 40px 8px rgb(201 220 92 / 0.5); }
  .mms__objetos.is-resuelto .mms__obj:not(.is-bien) { opacity: 0.25; filter: grayscale(0.6); pointer-events: none; }
  @keyframes mms-no { 20% { transform: translateX(-6px) rotate(-3deg); } 40% { transform: translateX(6px) rotate(3deg); } 60% { transform: translateX(-4px); } 80% { transform: translateX(3px); } }
  @keyframes mms-si { 0% { transform: scale(1); } 40% { transform: scale(1.18) rotate(-6deg); } 100% { transform: scale(1.06); } }
  .mms__exito { display: grid; justify-items: center; gap: 10px; margin-top: 6px; animation: mms-paso 0.5s cubic-bezier(.2,.8,.2,1); }
  .mms__candado { font-size: 2.6rem; line-height: 1; animation: mms-si 0.8s cubic-bezier(.2,1.4,.4,1); }

  /* sala */
  .mms__etiquetas { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 240px), 1fr)); gap: 16px; width: 100%; margin-top: 8px; }
  .mms__eti { display: grid; gap: 10px; background: rgb(255 255 255 / 0.75); border-radius: 24px; padding: 12px; transition: box-shadow 0.25s, transform 0.25s; }
  .mms__eti.is-elegida { box-shadow: 0 0 0 2.5px var(--deep); transform: translateY(-2px); }
  .mms__eti-img { position: relative; border: 0; padding: 0; border-radius: 16px; overflow: hidden; background: #fff; cursor: zoom-in; aspect-ratio: 4 / 3; display: grid; place-items: center; }
  .mms__eti-img img { width: 100%; height: 100%; object-fit: contain; display: block; }
  .mms__eti-vacia { display: grid; place-items: center; width: 100%; height: 100%; padding: 16px; background: var(--etiqueta); color: var(--green); font: 400 1.15rem/1.2 var(--serif); font-style: italic; }
  .mms__lupa-ico { position: absolute; right: 10px; bottom: 10px; width: 34px; height: 34px; border-radius: 50%; display: grid; place-items: center; background: rgb(255 255 255 / 0.9); color: var(--deep); font-size: 1rem; box-shadow: 0 2px 8px -3px rgb(0 0 0 / 0.3); }
  .mms__eti-elegir { display: flex; justify-content: space-between; align-items: center; gap: 10px; border: 0; border-radius: 999px; padding: 12px 16px; min-height: 48px; background: #fff; color: var(--deep); cursor: pointer; box-shadow: inset 0 0 0 1px rgb(30 51 34 / 0.18); }
  .mms__eti-nombre { font-weight: 400; }
  .mms__eti-check { font-size: 0.8rem; letter-spacing: 0.12em; text-transform: uppercase; }
  .mms__eti-elegir[aria-pressed="true"] { background: var(--deep); color: #fff; }
  .mms__eti-elegir[aria-pressed="true"] .mms__eti-check::before { content: "✓ "; }
  .mms__vh { position: absolute !important; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  .mms__elegida { display: flex; align-items: center; gap: 14px; width: min(100%, 420px); background: rgb(255 255 255 / 0.8); border-radius: 20px; padding: 10px 14px; text-align: left; }
  .mms__elegida img { width: 96px; height: 72px; object-fit: contain; border-radius: 10px; background: #fff; flex: none; }
  .mms__elegida b { font-weight: 400; }
  .mms__form { display: grid; gap: 12px; width: min(100%, 420px); text-align: left; }
  .mms__form input[type=email] { width: 100%; border: 0; border-radius: 999px; padding: 14px 18px; min-height: 50px; font: 300 1rem var(--sans); color: var(--ink); background: #fff; box-shadow: inset 0 0 0 1px rgb(30 51 34 / 0.22); }
  .mms__form input[type=email]:focus { outline: none; box-shadow: inset 0 0 0 1.5px var(--deep); }
  .mms__check { display: flex; gap: 10px; align-items: flex-start; font-size: 0.88rem; color: var(--muted); line-height: 1.4; cursor: pointer; }
  .mms__check input { width: 20px; height: 20px; margin: 1px 0 0; accent-color: var(--deep); flex: none; }
  .mms__legal { margin: 0; font-size: 0.75rem; color: var(--muted); }
  .mms__form .mms__btn { justify-self: center; }
  .mms__paso--sala [data-mms-votar] { position: sticky; bottom: max(14px, env(safe-area-inset-bottom, 0px)); z-index: 2; box-shadow: 0 10px 30px -10px rgb(30 51 34 / 0.55); }
  .mms__votar { margin: 8px 0 0; font: 500 0.95rem/1 var(--sans); letter-spacing: 0.24em; text-transform: uppercase; color: var(--deep); }

  /* ampliar */
  .mms__lupa { position: fixed; inset: 0; z-index: 5; background: rgb(20 36 26 / 0.92); display: grid; grid-template-rows: 1fr auto; padding: max(64px, calc(env(safe-area-inset-top, 0px) + 60px)) 0 max(18px, env(safe-area-inset-bottom, 0px)); }
  .mms__lupa-marco { overflow: auto; display: grid; place-items: center; -webkit-overflow-scrolling: touch; touch-action: pan-x pan-y pinch-zoom; }
  .mms__lupa-marco img { max-width: 94vw; max-height: 100%; height: auto; width: auto; cursor: zoom-in; transition: max-width 0.3s; }
  .mms__lupa.is-zoom .mms__lupa-marco { place-items: start; }
  .mms__lupa.is-zoom .mms__lupa-marco img { max-width: none; max-height: none; width: 220vw; cursor: zoom-out; }
  .mms__pista { margin: 10px 0 0; text-align: center; color: #dfe8d9; font-size: 0.85rem; }

  /* confeti */
  .mms__confeti { position: fixed; inset: 0; pointer-events: none; z-index: 6; overflow: hidden; }
  .mms__confeti i { position: absolute; top: -20px; left: var(--x); width: var(--s); height: var(--s); border-radius: 50%; background: var(--c); animation: mms-cae var(--t) cubic-bezier(.3,.6,.5,1) forwards; animation-delay: var(--d); }
  @keyframes mms-cae { to { transform: translate(var(--dx), 105vh) rotate(540deg); opacity: 0.9; } }

  @media (min-width: 760px) { .mms__objetos { gap: 20px; } }
  @media (prefers-reduced-motion: reduce) {
    .mms-trigger, .mms-trigger i, html.mms-glitch body, html.mms-glitch body::after, .mms, .mms__paso, .mms__obj, .mms__candado, .mms__exito, .mms__confeti i { animation: none !important; }
  }
</style>

<script>
(() => {
  const SID = '{{ sid }}';
  const capa = document.getElementById('mms-' + SID), trigger = document.getElementById('mms-trigger-' + SID);
  if (!capa || !trigger || capa.dataset.listo) return; capa.dataset.listo = '1';
  const $ = (s, r = capa) => r.querySelector(s), $$ = (s, r = capa) => [...r.querySelectorAll(s)];
  const ENDPOINT = (capa.dataset.endpoint || '').trim();
  const MAL = ({{ section.settings.errores | json }} || '').split(/\r?\n/).map(t => t.trim()).filter(Boolean);
  const guarda = { get(k){ try { return localStorage.getItem(k); } catch(e){ return null; } }, set(k, v){ try { localStorage.setItem(k, v); } catch(e){} } };
  const vibra = p => { try { navigator.vibrate && navigator.vibrate(p); } catch(e){} };
  const reducido = matchMedia('(prefers-reduced-motion: reduce)').matches;

  /* 1 · coloca el botón justo debajo de la frase tachada de «Lote 001» (sin tocar esa sección) */
  const h1 = document.querySelector('.mm-lote__hero h1');
  if (h1){ h1.insertAdjacentElement('afterend', trigger); } else { trigger.classList.add('mms-trigger--flotante'); document.body.appendChild(trigger); }
  trigger.hidden = false;

  /* identificador anónimo del votante (no es un dato personal) */
  function votante(){ let id = guarda.get('mms-votante');
    if (!id){ id = (crypto.randomUUID ? crypto.randomUUID() : Date.now().toString(36) + Math.random().toString(36).slice(2) + Math.random().toString(36).slice(2));
      guarda.set('mms-votante', id); try { document.cookie = 'mms_votante=' + id + ';max-age=31536000;path=/;SameSite=Lax'; } catch(e){} }
    return id; }
  function huella(){ const t = [navigator.language, screen.width + 'x' + screen.height, Intl.DateTimeFormat().resolvedOptions().timeZone, navigator.platform || ''].join('|');
    let h = 0; for (let i = 0; i < t.length; i++){ h = (h * 31 + t.charCodeAt(i)) | 0; } return (h >>> 0).toString(36); }

  /* navegación entre pasos */
  function paso(nombre){
    $$('.mms__paso').forEach(p => p.hidden = p.dataset.paso !== nombre);
    capa.classList.toggle('is-sala', ['sala','email','final'].includes(nombre));
    capa.scrollTop = 0;
    if (nombre === 'juego') empiezaJuego();
    if (nombre === 'sala') abreSala();
    const f = $(`.mms__paso[data-paso="${nombre}"] .mms__btn, .mms__paso[data-paso="${nombre}"] button`); if (f) setTimeout(() => f.focus({ preventScroll: true }), 50);
  }
  let abierta = false;
  function abre(){
    if (abierta) return; abierta = true; vibra([20, 40, 20]);
    const muestra = () => { capa.hidden = false; document.documentElement.style.overflow = 'hidden'; paso('aviso');
      try { history.pushState({ mmsSecreto: true }, '', location.href); } catch(e){} };
    if (reducido) return muestra();
    document.documentElement.classList.add('mms-glitch');
    setTimeout(() => { document.documentElement.classList.remove('mms-glitch'); muestra(); }, 650);
  }
  function cierra(desdeHistorial){
    if (!abierta) return; abierta = false; capa.hidden = true; $('[data-mms-lupa]').hidden = true; document.documentElement.style.overflow = '';
    if (!desdeHistorial && history.state && history.state.mmsSecreto) { try { history.back(); } catch(e){} }
    trigger.focus({ preventScroll: true });
  }
  trigger.addEventListener('click', abre);
  $$('[data-mms-cerrar]').forEach(b => b.addEventListener('click', () => cierra(false)));
  $$('[data-mms-ir]').forEach(b => b.addEventListener('click', () => paso(b.dataset.mmsIr)));
  addEventListener('popstate', () => { if (abierta) cierra(true); });
  addEventListener('keydown', e => { if (e.key === 'Escape' && abierta){ if (!$('[data-mms-lupa]').hidden) $('[data-mms-lupa]').hidden = true; else cierra(false); } });

  /* 2 · encuentra al impostor (posiciones aleatorias en cada partida) */
  let fallos = 0;
  function baraja(a){ for (let i = a.length - 1; i > 0; i--){ const j = Math.floor(Math.random() * (i + 1)); [a[i], a[j]] = [a[j], a[i]]; } return a; }
  function empiezaJuego(){
    fallos = 0; const caja = $('[data-mms-objetos]'), msg = $('[data-mms-msg]');
    const plantilla = document.getElementById('mms-objetos-' + SID).content.cloneNode(true);
    caja.replaceChildren(...baraja([...plantilla.querySelectorAll('.mms__obj')]));
    caja.classList.remove('is-resuelto'); $('[data-mms-exito]').hidden = true; msg.textContent = ''; msg.classList.remove('is-mal');
    $$('.mms__obj', caja).forEach((b, i) => { b.setAttribute('aria-label', 'Objeto ' + (i + 1)); b.addEventListener('click', () => elige(b)); });
  }
  function elige(b){
    const caja = $('[data-mms-objetos]'), msg = $('[data-mms-msg]');
    if (caja.classList.contains('is-resuelto')) return;
    if (b.dataset.tipo === 'cafetera'){
      b.classList.add('is-bien'); caja.classList.add('is-resuelto'); msg.textContent = ''; vibra([30, 60, 30, 60, 140]); confeti();
      guarda.set('mms-resuelto', '1'); setTimeout(() => { $('[data-mms-exito]').hidden = false; $('[data-mms-exito] .mms__btn').focus({ preventScroll: true }); }, 450);
      return;
    }
    fallos++; vibra(70); b.classList.remove('is-mal'); void b.offsetWidth; b.classList.add('is-mal'); setTimeout(() => b.classList.remove('is-mal'), 600);
    msg.classList.add('is-mal'); msg.textContent = MAL.length ? MAL[(fallos - 1) % MAL.length] : 'Uy… creo que necesitas otro matcha 😂';
    if (fallos >= 3) msg.textContent += ' Pista: uno de ellos es de otra bebida ☕';
  }
  function confeti(){
    if (reducido) return; const c = $('[data-mms-confeti]'), cols = ['#9cc14a', '#c9dc5c', '#1e3322', '#f4e278', '#add9af', '#f3e5cd'];
    c.replaceChildren(...Array.from({ length: 34 }, () => { const i = document.createElement('i');
      i.style.cssText = `--x:${Math.random() * 100}%;--s:${6 + Math.random() * 8}px;--c:${cols[Math.floor(Math.random() * cols.length)]};--t:${1.2 + Math.random()}s;--d:${Math.random() * 0.25}s;--dx:${(Math.random() - 0.5) * 120}px`; return i; }));
    setTimeout(() => c.replaceChildren(), 2600);
  }

  /* 3 · sala secreta: solo se monta tras superar el juego */
  let elegida = null;
  function abreSala(){
    const caja = $('[data-mms-etiquetas]'), estado = $('[data-mms-estado]'), boton = $('[data-mms-votar]');
    if (!caja.children.length) caja.appendChild(document.getElementById('mms-etiquetas-' + SID).content.cloneNode(true));
    const previo = guarda.get('mms-voto');
    $$('[data-mms-elegir]', caja).forEach(b => b.onclick = () => {
      if (guarda.get('mms-voto')) return;
      elegida = b.closest('.mms__eti').dataset.codigo;
      $$('.mms__eti', caja).forEach(e => { const yo = e.dataset.codigo === elegida; e.classList.toggle('is-elegida', yo); $('[data-mms-elegir]', e).setAttribute('aria-pressed', yo); $('.mms__eti-check', e).textContent = yo ? 'Elegida' : 'Elegir'; });
      boton.disabled = false; estado.textContent = ''; estado.classList.remove('is-mal'); });
    $$('[data-mms-ampliar]', caja).forEach(b => b.onclick = () => { const img = $('img', b); if (!img) return;
      const lupa = $('[data-mms-lupa]'); $('[data-mms-lupa-img]').src = img.dataset.grande || img.currentSrc || img.src; $('[data-mms-lupa-img]').alt = img.alt; lupa.classList.remove('is-zoom'); lupa.hidden = false; });
    if (previo){
      const p = JSON.parse(previo); boton.disabled = false; boton.textContent = 'Continuar';
      $$('.mms__eti', caja).forEach(e => { const yo = e.dataset.codigo === p.codigo; e.classList.toggle('is-elegida', yo); $('[data-mms-elegir]', e).setAttribute('aria-pressed', yo); $('.mms__eti-check', e).textContent = yo ? 'Tu voto' : ''; });
      estado.classList.remove('is-mal'); estado.textContent = 'Ya votaste desde este móvil. ¡Gracias, mini socia!';
    }
  }
  $('[data-mms-lupa-cerrar]').addEventListener('click', () => $('[data-mms-lupa]').hidden = true);
  $('[data-mms-lupa-img]').addEventListener('click', () => $('[data-mms-lupa]').classList.toggle('is-zoom'));

  $('[data-mms-votar]').addEventListener('click', () => {
    if (guarda.get('mms-voto')) return paso('final');
    if (!elegida) return;
    const eti = $(`.mms__eti[data-codigo="${elegida}"]`), img = eti && $('img', eti);
    $('[data-mms-elegida]').innerHTML = (img ? `<img src="${img.currentSrc || img.src}" alt="">` : '') + `<span>Has elegido la <b>${$('.mms__eti-nombre', eti).textContent}</b></span>`;
    $('[data-mms-error]').textContent = ''; paso('email');
  });

  /* 3b · el voto solo cuenta con email (uno por email) */
  $('[data-mms-form]').addEventListener('submit', async e => {
    e.preventDefault();
    const f = e.target, error = $('[data-mms-error]'), boton = $('button[type=submit]', f);
    const email = f.email.value.trim().toLowerCase(), novedades = f.novedades.checked;
    error.classList.add('is-mal');
    if (!/^[^@\s]+@[^@\s]+\.[^@\s]{2,}$/.test(email)){ error.textContent = 'Revisa el email: parece que falta algo.'; f.email.focus(); return; }
    if (!ENDPOINT){ error.textContent = 'La votación se abre muy pronto. Vuelve en un rato 🍵'; return; }
    boton.disabled = true; error.classList.remove('is-mal'); error.textContent = 'Guardando tu voto…';
    try {
      const r = await fetch(ENDPOINT, { method: 'POST', body: JSON.stringify({ voto: elegida, email, novedades, votante: votante(), huella: huella(), origen: location.host }) });
      const d = await r.json();
      if (d.ok || d.error === 'duplicado'){
        guarda.set('mms-voto', JSON.stringify({ codigo: elegida, fecha: Date.now() }));
        if (novedades) suscribe(email);
        vibra([30, 60, 120]); confeti(); paso('final');
        if (d.error === 'duplicado') $('[data-mms-compartido]').textContent = 'Este email ya había votado, así que contamos tu primer voto. ¡Gracias!';
      } else { throw new Error(d.error || 'error'); }
    } catch(err){
      boton.disabled = false; error.classList.add('is-mal'); error.textContent = 'No hemos podido guardar tu voto. Revisa tu conexión e inténtalo otra vez.';
    }
  });
  /* si acepta novedades, también la apuntamos a la newsletter de Shopify (sin recargar la página) */
  function suscribe(email){
    try { const fd = new FormData(); fd.append('form_type', 'customer'); fd.append('utf8', '✓'); fd.append('contact[email]', email); fd.append('contact[tags]', {{ section.settings.email_etiquetas | json }});
      fetch('/contact', { method: 'POST', body: fd, credentials: 'same-origin' }).catch(() => {}); } catch(e){}
  }

  /* 4 · compartir */
  $('[data-mms-compartir]').addEventListener('click', async () => {
    const texto = capa.dataset.compartir, url = capa.dataset.url || location.origin, aviso = $('[data-mms-compartido]');
    if (navigator.share){ try { await navigator.share({ title: 'Mood Matcha', text: texto, url }); return; } catch(e){ if (e && e.name === 'AbortError') return; } }
    try { await navigator.clipboard.writeText(texto + ' ' + url); aviso.textContent = 'Enlace copiado. ¡Pásaselo a quien quieras!'; }
    catch(e){ aviso.textContent = texto + ' ' + url; }
  });
})();
</script>

